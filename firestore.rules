rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Cases collection: live data real-time sync across all clients and PIN admin
    match /cases/{caseId} {
      allow read, write: if true;
    }

    // Monthly duty rosters collection
    match /duty_rosters/{rosterId} {
      allow read, write: if true;
    }

    // Daily judgment follow-ups collection
    match /follow_ups/{followUpId} {
      allow read, write: if true;
    }

    // Settings collection (permissions, admin PIN, app configuration)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Permission requests collection
    match /permission_requests/{requestId} {
      allow read, write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
